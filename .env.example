# ==============================================================================
# DONUT // AUTO-SELL v3.0 — PRODUCTION CONFIGURATION
# Copy this file to .env and fill in your credentials before running `npm start`
# ==============================================================================

# --- Control Plane Server ---
PORT=3000
NODE_ENV=production
STORE_NAME="DonutVault Exchange"
POLL_INTERVAL_MS=8000

# --- Eldorado.gg Verified Seller API ---
ELDO_CLIENT_ID=your_eldorado_client_id
ELDO_CLIENT_SECRET=your_eldorado_client_secret
ELDO_DEFAULT_OFFER_ID=offer-278-xxxxxxxx

# --- DonutSMP Minecraft Worker Account ---
MC_HOST=play.donutsmp.net
MC_PORT=25565
MC_VERSION=1.20.4
MC_USERNAME=worker_account@outlook.com
MC_AUTH=microsoft
ANTI_AFK_INTERVAL_MS=45000

# --- Optional Residential SOCKS5 Proxy ---
SOCKS_HOST=
SOCKS_PORT=1080
SOCKS_USER=
SOCKS_PASS=

# --- Fulfillment Rules & Safety Guardrails ---
DEFAULT_UNIT_MULTIPLIER=1000000
DELIVERY_CMD_TEMPLATE="/pay {ign} {amount}"
MIN_SAFE_VAULT_BALANCE=500000000
MAX_SINGLE_ORDER_PAYOUT=50000000000

# --- Discord Real-Time Webhook Notifications ---
DISCORD_WEBHOOK_URL=
